      "backend": "drama-3",
      "tone_control": true
    }
  },
  "stt": {
    "provider": "fish_audio",
    "auto_send": {
      "enabled": true,
      "delay_seconds": 5
    },
    "smart_turn": {
      "enabled": true,
      "threshold": 0.5
