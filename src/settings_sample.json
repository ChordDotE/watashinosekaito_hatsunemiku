{
  "api_keys": {
    "google": "put your Google AI Studio API key",
    "fish_audio": "put your Fish Audio API key",
    "tavily": "put your Tavily API key",
    "gmail_app_password": "put your Gmail app password"
  },
  "llm": {
    "flash_model": "google-gla:gemini-3.8-flash",
    "pro_model": "google-gla:gemini-3.1-pro-preview",
    "lite_model": "google-gla:gemini-3.1-flash-lite",
